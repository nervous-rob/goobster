{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://goobster.local/schemas/manager-install-answers.json",
    "title": "Goobster manager CLI answers file",
    "description": "Input of `goobster-manager <command> --answers <file>`. One document per command; `command` is optional when the CLI command names it. The `migrate` commands use the definitions `migrate-preflight` (preflight), `migrate` (run) and `migrate-rollback`; their `command` is `migrate`. The file may hold secrets (config values of secret fields) and must be readable by its owner only (mode 0600).",
    "oneOf": [
        { "$ref": "#/definitions/install" },
        { "$ref": "#/definitions/adopt" },
        { "$ref": "#/definitions/reconfigure" },
        { "$ref": "#/definitions/repair" },
        { "$ref": "#/definitions/uninstall" },
        { "$ref": "#/definitions/reset" }
    ],
    "definitions": {
        "absolutePath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "layout": { "enum": ["lite", "standalone", "paired"] },
        "ownerLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "featureList": { "type": "array", "maxItems": 80, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,40}$" } },
        "roots": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "code": { "$ref": "#/definitions/absolutePath" },
                "data": { "$ref": "#/definitions/absolutePath" },
                "config": { "$ref": "#/definitions/absolutePath" },
                "cache": { "$ref": "#/definitions/absolutePath" },
                "logs": { "$ref": "#/definitions/absolutePath" },
                "uploads": { "$ref": "#/definitions/absolutePath" },
                "managerStore": { "$ref": "#/definitions/absolutePath" }
            }
        },
        "release": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "publicKeyFiles": { "type": "array", "maxItems": 8, "items": { "$ref": "#/definitions/absolutePath" } },
                "allowUnsigned": { "type": "boolean" }
            }
        },
        "database": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "engine": { "enum": ["sqlite", "postgres"] } }
        },
        "dbConnection": {
            "type": "object",
            "description": "An existing PostgreSQL server (documentation/database_connection.md). The password is a secret: the answers file must be mode 0600; the CLI also reads it from a hidden prompt or GOOBSTER_DB_PASSWORD_FILE.",
            "additionalProperties": false,
            "required": ["host", "database", "user"],
            "properties": {
                "host": { "type": "string", "minLength": 1, "maxLength": 253 },
                "port": { "type": "integer" },
                "database": { "type": "string", "minLength": 1, "maxLength": 63 },
                "schema": { "type": "string", "minLength": 1, "maxLength": 63 },
                "user": { "type": "string", "minLength": 1, "maxLength": 63 },
                "password": { "type": "string", "maxLength": 512 },
                "tls": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "mode": { "enum": ["disable", "prefer", "require", "verify-full"] },
                        "caFile": { "$ref": "#/definitions/absolutePath" }
                    }
                }
            }
        },
        "newDatabase": {
            "type": "object",
            "description": "install: the engine, and for postgres the existing server to use. Without `connection` a postgres install uses GOOBSTER_DB_URL as before.",
            "additionalProperties": false,
            "properties": {
                "engine": { "enum": ["sqlite", "postgres"] },
                "connection": { "$ref": "#/definitions/dbConnection" }
            }
        },
        "config": {
            "type": "array",
            "maxItems": 64,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "value"],
                "properties": {
                    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
                    "value": {}
                }
            }
        },
        "install": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "install" },
                "source": { "$ref": "#/definitions/absolutePath" },
                "ownerLabel": { "$ref": "#/definitions/ownerLabel" },
                "features": { "$ref": "#/definitions/featureList" },
                "layout": { "$ref": "#/definitions/layout" },
                "roots": { "$ref": "#/definitions/roots" },
                "database": { "$ref": "#/definitions/newDatabase" },
                "release": { "$ref": "#/definitions/release" },
                "runtimeUser": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$" },
                "config": { "$ref": "#/definitions/config" },
                "registerService": { "type": "boolean" }
            }
        },
        "adopt": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "adopt" },
                "label": { "$ref": "#/definitions/ownerLabel" },
                "candidateId": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
                "roots": { "$ref": "#/definitions/roots" },
                "layout": { "$ref": "#/definitions/layout" },
                "database": { "$ref": "#/definitions/database" },
                "keepUpdater": { "type": "boolean" },
                "replaceUnreadable": { "type": "boolean" }
            }
        },
        "reconfigure": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "reconfigure" },
                "layout": { "$ref": "#/definitions/layout" },
                "roots": { "$ref": "#/definitions/roots" },
                "source": { "$ref": "#/definitions/absolutePath" },
                "release": { "$ref": "#/definitions/release" },
                "config": { "$ref": "#/definitions/config" }
            }
        },
        "repair": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "repair" },
                "source": { "$ref": "#/definitions/absolutePath" },
                "release": { "$ref": "#/definitions/release" }
            }
        },
        "uninstall": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "uninstall" },
                "keepData": { "type": "boolean" },
                "confirm": { "type": "string", "minLength": 1, "maxLength": 64 },
                "acknowledgeUnknownServices": { "type": "boolean" }
            }
        },
        "reset": {
            "type": "object",
            "additionalProperties": false,
            "description": "goobster-manager reset: empty the installation's data (documentation/data_reset.md). backup.passphrase is read from this file or the hidden prompt, never the command line. confirm is the installation id (<installationId>:<feature> for a purge); --confirm on the command line does the same.",
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "reset" },
                "scope": { "enum": ["instance", "feature"] },
                "feature": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,31}$" },
                "backup": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "dir": { "$ref": "#/definitions/absolutePath" },
                        "passphrase": { "type": "string", "minLength": 1, "maxLength": 1024 },
                        "skipConfig": { "type": "boolean" }
                    }
                },
                "confirm": { "type": "string", "minLength": 1, "maxLength": 96 },
                "timeoutSeconds": { "type": "integer" }
            }
        },
        "migrateTarget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
                "url": { "type": "string", "minLength": 12, "maxLength": 2048, "pattern": "^postgres(ql)?://" }
            }
        },
        "migrate-preflight": {
            "type": "object",
            "description": "`goobster-manager migrate preflight`: the read-only inspection of the target. The URL may carry a password; the file must be mode 0600.",
            "additionalProperties": false,
            "required": ["target"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "migrate" },
                "target": { "$ref": "#/definitions/migrateTarget" }
            }
        },
        "migrate": {
            "type": "object",
            "description": "`goobster-manager migrate run`: copy the SQLite database to the Postgres target and switch the installation to it. `confirm` (or --confirm) is the installation id.",
            "additionalProperties": false,
            "required": ["target", "backup"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "migrate" },
                "target": { "$ref": "#/definitions/migrateTarget" },
                "backup": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["dir"],
                    "properties": {
                        "dir": { "$ref": "#/definitions/absolutePath" },
                        "passphrase": { "type": "string", "minLength": 1, "maxLength": 1024 },
                        "skipConfig": { "type": "boolean" }
                    }
                },
                "provision": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "extensions": { "type": "boolean" }
                    }
                },
                "confirm": { "type": "string", "minLength": 1, "maxLength": 200 },
                "roots": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "data": { "$ref": "#/definitions/absolutePath" }
                    }
                },
                "release": { "type": "boolean" }
            }
        },
        "migrate-rollback": {
            "type": "object",
            "description": "`goobster-manager migrate rollback`: undo a migration before the first write reaches Postgres. `target` is needed when the migration created objects on it.",
            "additionalProperties": false,
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "migrate" },
                "target": { "$ref": "#/definitions/migrateTarget" },
                "confirm": { "type": "string", "minLength": 1, "maxLength": 200 },
                "releaseMaintenance": { "type": "boolean" }
            }
        },
        "database-test": {
            "type": "object",
            "description": "`goobster-manager database test`: the read-only probe of an existing server. Nothing is written to the server or to the installation.",
            "additionalProperties": false,
            "required": ["connection"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "database" },
                "connection": { "$ref": "#/definitions/dbConnection" }
            }
        },
        "database-provision": {
            "type": "object",
            "description": "`goobster-manager database provision`: create what the probe said is missing, with an elevated credential used for this operation only and never saved. `actions` lists exactly what to do.",
            "additionalProperties": false,
            "required": ["connection", "elevated", "actions"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "database" },
                "connection": { "$ref": "#/definitions/dbConnection" },
                "elevated": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["user"],
                    "properties": {
                        "user": { "type": "string", "minLength": 1, "maxLength": 63 },
                        "password": { "type": "string", "maxLength": 512 },
                        "database": { "type": "string", "minLength": 1, "maxLength": 63 }
                    }
                },
                "actions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": { "enum": ["create-role", "create-database", "create-extension.citext", "create-extension.vector", "create-schema", "grant"] }
                }
            }
        },
        "database-schema": {
            "type": "object",
            "description": "`goobster-manager database schema`: apply Goobster's schema to an empty schema, or bring an older Goobster schema up to date. Never on a schema that holds anything else.",
            "additionalProperties": false,
            "required": ["connection"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "database" },
                "connection": { "$ref": "#/definitions/dbConnection" }
            }
        },
        "database-connect": {
            "type": "object",
            "description": "`goobster-manager database connect`: point an existing installation at the server (inside the maintenance barrier). A SQLite installation that holds data is refused: that is `migrate`.",
            "additionalProperties": false,
            "required": ["connection"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "database" },
                "connection": { "$ref": "#/definitions/dbConnection" },
                "release": { "type": "boolean" }
            }
        }
    }
}

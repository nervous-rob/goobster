{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://goobster.local/schemas/manager-install-answers.json",
    "title": "Goobster manager CLI answers file",
    "description": "Input of `goobster-manager <command> --answers <file>`. One document per command; `command` is optional when the CLI command names it. The `migrate` commands use the definitions `migrate-preflight` (preflight), `migrate` (run) and `migrate-rollback`; their `command` is `migrate`. `backup` and `restore` have their own definitions of the same names. The file may hold secrets (config values of secret fields) and must be readable by its owner only (mode 0600).",
    "oneOf": [
        { "$ref": "#/definitions/install" },
        { "$ref": "#/definitions/adopt" },
        { "$ref": "#/definitions/reconfigure" },
        { "$ref": "#/definitions/repair" },
        { "$ref": "#/definitions/uninstall" },
        { "$ref": "#/definitions/reset" }
    ],
    "definitions": {
        "absolutePath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "layout": { "enum": ["lite", "standalone", "paired"] },
        "ownerLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "updateAnswer": {
            "description": "The one question about updates, asked once at install or adoption. The window and the source are set later with the update command.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "mode": { "enum": ["off", "check", "download", "apply"] },
                "channel": { "enum": ["stable", "prerelease"] }
            }
        },
        "featureList": { "type": "array", "maxItems": 80, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,40}$" } },
        "roots": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "code": { "$ref": "#/definitions/absolutePath" },
                "data": { "$ref": "#/definitions/absolutePath" },
                "config": { "$ref": "#/definitions/absolutePath" },
                "cache": { "$ref": "#/definitions/absolutePath" },
                "logs": { "$ref": "#/definitions/absolutePath" },
                "uploads": { "$ref": "#/definitions/absolutePath" },
                "managerStore": { "$ref": "#/definitions/absolutePath" }
            }
        },
        "release": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "publicKeyFiles": { "type": "array", "maxItems": 8, "items": { "$ref": "#/definitions/absolutePath" } },
                "allowUnsigned": { "type": "boolean" }
            }
        },
        "database": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "engine": { "enum": ["sqlite", "postgres"] } }
        },
        "dbConnection": {
            "type": "object",
            "description": "An existing PostgreSQL server (documentation/database_connection.md). The password is a secret: the answers file must be mode 0600; the CLI also reads it from a hidden prompt or GOOBSTER_DB_PASSWORD_FILE.",
            "additionalProperties": false,
            "required": ["host", "database", "user"],
            "properties": {
                "host": { "type": "string", "minLength": 1, "maxLength": 253 },
                "port": { "type": "integer" },
                "database": { "type": "string", "minLength": 1, "maxLength": 63 },
                "schema": { "type": "string", "minLength": 1, "maxLength": 63 },
                "user": { "type": "string", "minLength": 1, "maxLength": 63 },
                "password": { "type": "string", "maxLength": 512 },
                "tls": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "mode": { "enum": ["disable", "prefer", "require", "verify-full"] },
                        "caFile": { "$ref": "#/definitions/absolutePath" }
                    }
                }
            }
        },
        "newDatabase": {
            "type": "object",
            "description": "install: the engine, and for postgres the existing server to use. Without `connection` a postgres install uses GOOBSTER_DB_URL as before.",
            "additionalProperties": false,
            "properties": {
                "engine": { "enum": ["sqlite", "postgres"] },
                "connection": { "$ref": "#/definitions/dbConnection" },
                "docker": { "$ref": "#/definitions/dockerRequest" },
                "native": { "$ref": "#/definitions/nativeRequest" }
            }
        },
        "nativeRequest": {
            "type": "object",
            "description": "A PostgreSQL cluster the installer creates and owns on this machine, with the distribution's packages (documentation/native_postgres.md). Give one of `connection`, `docker` or `native`. No password is asked: it is generated, and only its SCRAM-SHA-256 verifier reaches the privileged helper.",
            "additionalProperties": false,
            "properties": {
                "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
                "bind": { "type": "string", "minLength": 7, "maxLength": 15, "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$" },
                "acknowledgeLanBind": { "type": "boolean" },
                "dataDirectory": { "type": "string", "minLength": 2, "maxLength": 200, "pattern": "^/[A-Za-z0-9._+/-]+$", "description": "Where the cluster's data lives. Default: the distribution's data parent directory plus the cluster name." },
                "role": { "type": "string", "minLength": 1, "maxLength": 63 },
                "database": { "type": "string", "minLength": 1, "maxLength": 63 },
                "installPackages": { "type": "boolean", "description": "Approve installing the PostgreSQL 17 packages (and the PostgreSQL project's signed repository when the distribution has none) if they are missing." },
                "acknowledgeBackupTools": { "type": "boolean" },
                "acknowledgeMount": { "type": "boolean", "description": "Accept a data directory on a mount that is not listed in /etc/fstab." }
            }
        },
        "ownedNativeRef": {
            "type": "object",
            "description": "The native database this manager provisioned and has not connected yet, instead of a connection: its generated password is read from the manager overlay and never shown.",
            "additionalProperties": false,
            "required": ["owned"],
            "properties": {
                "owned": { "const": "native" }
            }
        },
        "dockerRequest": {
            "type": "object",
            "description": "A PostgreSQL instance the installer creates and owns in Docker (documentation/docker_postgres.md). Give `connection` or `docker`, not both. No password is asked: they are generated.",
            "additionalProperties": false,
            "properties": {
                "port": { "type": "integer" },
                "bind": { "type": "string", "minLength": 7, "maxLength": 15, "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$" },
                "acknowledgeLanBind": { "type": "boolean" },
                "storage": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "kind": { "enum": ["volume", "path"] },
                        "path": { "$ref": "#/definitions/absolutePath" }
                    }
                },
                "role": { "type": "string", "minLength": 1, "maxLength": 63 },
                "database": { "type": "string", "minLength": 1, "maxLength": 63 },
                "memoryMb": { "type": "integer" },
                "pull": { "type": "boolean" },
                "acknowledgeBackupTools": { "type": "boolean" }
            }
        },
        "ownedDockerRef": {
            "type": "object",
            "description": "The Docker database this manager provisioned and has not connected yet, instead of a connection: its generated password is read from the manager overlay and never shown.",
            "additionalProperties": false,
            "required": ["owned"],
            "properties": {
                "owned": { "const": "docker" }
            }
        },
        "config": {
            "type": "array",
            "maxItems": 64,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "value"],
                "properties": {
                    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
                    "value": {}
                }
            }
        },
        "install": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "install" },
                "source": { "$ref": "#/definitions/absolutePath" },
                "ownerLabel": { "$ref": "#/definitions/ownerLabel" },
                "features": { "$ref": "#/definitions/featureList" },
                "layout": { "$ref": "#/definitions/layout" },
                "roots": { "$ref": "#/definitions/roots" },
                "database": { "$ref": "#/definitions/newDatabase" },
                "release": { "$ref": "#/definitions/release" },
                "runtimeUser": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$" },
                "createRuntimeUser": { "type": "boolean", "description": "Create `runtimeUser` as a no-login system account through the privileged helper; needs the installer to run as root." },
                "config": { "$ref": "#/definitions/config" },
                "update": { "$ref": "#/definitions/updateAnswer" },
                "registerService": { "type": "boolean" }
            }
        },
        "adopt": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "adopt" },
                "label": { "$ref": "#/definitions/ownerLabel" },
                "candidateId": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
                "roots": { "$ref": "#/definitions/roots" },
                "layout": { "$ref": "#/definitions/layout" },
                "database": { "$ref": "#/definitions/database" },
                "keepUpdater": { "type": "boolean" },
                "update": { "$ref": "#/definitions/updateAnswer" },
                "replaceUnreadable": { "type": "boolean" }
            }
        },
        "reconfigure": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "reconfigure" },
                "layout": { "$ref": "#/definitions/layout" },
                "roots": { "$ref": "#/definitions/roots" },
                "source": { "$ref": "#/definitions/absolutePath" },
                "release": { "$ref": "#/definitions/release" },
                "config": { "$ref": "#/definitions/config" }
            }
        },
        "repair": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "repair" },
                "source": { "$ref": "#/definitions/absolutePath" },
                "release": { "$ref": "#/definitions/release" }
            }
        },
        "uninstall": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "uninstall" },
                "keepData": { "type": "boolean" },
                "confirm": { "type": "string", "minLength": 1, "maxLength": 64 },
                "acknowledgeUnknownServices": { "type": "boolean" },
                "removeDockerData": { "type": "boolean", "description": "Also remove the Docker database this manager owns: its container, data volume and network (a host directory you chose is never deleted). Needs confirm." },
                "removeNativeData": { "type": "boolean", "description": "Also remove the native PostgreSQL cluster this manager owns, with its data directory (the PostgreSQL packages stay installed). Needs confirm with the installation id." }
            }
        },
        "reset": {
            "type": "object",
            "additionalProperties": false,
            "description": "goobster-manager reset: empty the installation's data (documentation/data_reset.md). backup.passphrase is read from this file or the hidden prompt, never the command line. confirm is the installation id (<installationId>:<feature> for a purge); --confirm on the command line does the same.",
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "reset" },
                "scope": { "enum": ["instance", "feature"] },
                "feature": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,31}$" },
                "backup": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "dir": { "$ref": "#/definitions/absolutePath" },
                        "passphrase": { "type": "string", "minLength": 1, "maxLength": 1024 },
                        "skipConfig": { "type": "boolean" }
                    }
                },
                "confirm": { "type": "string", "minLength": 1, "maxLength": 96 },
                "timeoutSeconds": { "type": "integer" }
            }
        },
        "migrateTarget": {
            "type": "object",
            "description": "`url` (a postgres:// URL), or `owned: docker` / `owned: native` for the Docker database or native cluster this manager provisioned and has not connected yet. Exactly one of them; the manager refuses both or neither.",
            "additionalProperties": false,
            "properties": {
                "url": { "type": "string", "minLength": 12, "maxLength": 2048, "pattern": "^postgres(ql)?://" },
                "owned": { "enum": ["docker", "native"] }
            }
        },
        "migrate-preflight": {
            "type": "object",
            "description": "`goobster-manager migrate preflight`: the read-only inspection of the target. The URL may carry a password; the file must be mode 0600.",
            "additionalProperties": false,
            "required": ["target"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "migrate" },
                "target": { "$ref": "#/definitions/migrateTarget" }
            }
        },
        "migrate": {
            "type": "object",
            "description": "`goobster-manager migrate run`: copy the SQLite database to the Postgres target and switch the installation to it. `confirm` (or --confirm) is the installation id.",
            "additionalProperties": false,
            "required": ["target", "backup"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "migrate" },
                "target": { "$ref": "#/definitions/migrateTarget" },
                "backup": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["dir"],
                    "properties": {
                        "dir": { "$ref": "#/definitions/absolutePath" },
                        "passphrase": { "type": "string", "minLength": 1, "maxLength": 1024 },
                        "skipConfig": { "type": "boolean" }
                    }
                },
                "provision": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "extensions": { "type": "boolean" }
                    }
                },
                "confirm": { "type": "string", "minLength": 1, "maxLength": 200 },
                "roots": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "data": { "$ref": "#/definitions/absolutePath" }
                    }
                },
                "release": { "type": "boolean" }
            }
        },
        "migrate-rollback": {
            "type": "object",
            "description": "`goobster-manager migrate rollback`: undo a migration before the first write reaches Postgres. `target` is needed when the migration created objects on it.",
            "additionalProperties": false,
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "migrate" },
                "target": { "$ref": "#/definitions/migrateTarget" },
                "confirm": { "type": "string", "minLength": 1, "maxLength": 200 },
                "releaseMaintenance": { "type": "boolean" }
            }
        },
        "backup": {
            "type": "object",
            "description": "`goobster-manager backup`: write a verified archive (documentation/backup_and_restore.md). `passphrase` encrypts config.json only (the archive itself is not encrypted); it is read from this file, --passphrase-file or the hidden prompt, never the command line. `dir` is the same as --out.",
            "additionalProperties": false,
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "backup" },
                "dir": { "$ref": "#/definitions/absolutePath" },
                "includeConfig": { "type": "boolean" },
                "passphrase": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
        },
        "restore": {
            "type": "object",
            "description": "`goobster-manager restore`: replace the database, the file sets and (with the passphrase) config.json from an archive. `confirm` is the installation id; it and `dir` are the same as the command-line values. `passphrase` unlocks the archive's config.json and is read from this file, --passphrase-file or the hidden prompt, never the command line.",
            "additionalProperties": false,
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "restore" },
                "dir": { "$ref": "#/definitions/absolutePath" },
                "confirm": { "type": "string", "minLength": 1, "maxLength": 200 },
                "withoutConfig": { "type": "boolean" },
                "passphrase": { "type": "string", "minLength": 1, "maxLength": 1024 },
                "acceptSchemaChange": { "type": "boolean" },
                "release": { "type": "boolean" }
            }
        },
        "database-test": {
            "type": "object",
            "description": "`goobster-manager database test`: the read-only probe of an existing server. Nothing is written to the server or to the installation.",
            "additionalProperties": false,
            "required": ["connection"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "database" },
                "connection": { "$ref": "#/definitions/dbConnection" }
            }
        },
        "database-provision": {
            "type": "object",
            "description": "`goobster-manager database provision`: create what the probe said is missing, with an elevated credential used for this operation only and never saved. `actions` lists exactly what to do.",
            "additionalProperties": false,
            "required": ["connection", "elevated", "actions"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "database" },
                "connection": { "$ref": "#/definitions/dbConnection" },
                "elevated": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["user"],
                    "properties": {
                        "user": { "type": "string", "minLength": 1, "maxLength": 63 },
                        "password": { "type": "string", "maxLength": 512 },
                        "database": { "type": "string", "minLength": 1, "maxLength": 63 }
                    }
                },
                "actions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": { "enum": ["create-role", "create-database", "create-extension.citext", "create-extension.vector", "create-schema", "grant"] }
                }
            }
        },
        "database-schema": {
            "type": "object",
            "description": "`goobster-manager database schema`: apply Goobster's schema to an empty schema, or bring an older Goobster schema up to date. Never on a schema that holds anything else.",
            "additionalProperties": false,
            "required": ["connection"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "database" },
                "connection": { "$ref": "#/definitions/dbConnection" }
            }
        },
        "database-connect": {
            "type": "object",
            "description": "`goobster-manager database connect`: point an existing installation at the server (inside the maintenance barrier). A SQLite installation that holds data is refused: that is `migrate`.",
            "additionalProperties": false,
            "required": ["connection"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "database" },
                "connection": { "oneOf": [{ "$ref": "#/definitions/dbConnection" }, { "$ref": "#/definitions/ownedDockerRef" }, { "$ref": "#/definitions/ownedNativeRef" }] },
                "release": { "type": "boolean" }
            }
        },
        "database-docker-status": {
            "type": "object",
            "description": "`goobster-manager database docker status`: the daemon check and what this manager owns. Read only; takes no answers.",
            "additionalProperties": false,
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "database" }
            }
        },
        "database-docker-provision": {
            "type": "object",
            "description": "`goobster-manager database docker provision`: create the container, volume and network, the application role and the schema. The installation is connected afterwards with `database connect` and `connection: { owned: docker }`.",
            "additionalProperties": false,
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "database" },
                "port": { "type": "integer" },
                "bind": { "type": "string", "minLength": 7, "maxLength": 15, "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$" },
                "acknowledgeLanBind": { "type": "boolean" },
                "storage": { "$ref": "#/definitions/dockerRequest/properties/storage" },
                "role": { "type": "string", "minLength": 1, "maxLength": 63 },
                "database": { "type": "string", "minLength": 1, "maxLength": 63 },
                "memoryMb": { "type": "integer" },
                "pull": { "type": "boolean" },
                "acknowledgeBackupTools": { "type": "boolean" }
            }
        },
        "database-docker-start": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "$schema": { "type": "string" }, "command": { "const": "database" } }
        },
        "database-docker-stop": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "$schema": { "type": "string" }, "command": { "const": "database" }, "acknowledgeInUse": { "type": "boolean" } }
        },
        "database-docker-repair": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "$schema": { "type": "string" }, "command": { "const": "database" } }
        },
        "database-native-status": {
            "type": "object",
            "description": "`goobster-manager database native status`: the host check and what this manager owns. Read only; takes no answers.",
            "additionalProperties": false,
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "database" }
            }
        },
        "database-native-provision": {
            "type": "object",
            "description": "`goobster-manager database native provision`: install the packages when approved, create the cluster, the application role and the schema. The installation is connected afterwards with `database connect` and `connection: { owned: native }`.",
            "additionalProperties": false,
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "database" },
                "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
                "bind": { "type": "string", "minLength": 7, "maxLength": 15, "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$" },
                "acknowledgeLanBind": { "type": "boolean" },
                "dataDirectory": { "$ref": "#/definitions/nativeRequest/properties/dataDirectory" },
                "role": { "type": "string", "minLength": 1, "maxLength": 63 },
                "database": { "type": "string", "minLength": 1, "maxLength": 63 },
                "installPackages": { "type": "boolean" },
                "acknowledgeBackupTools": { "type": "boolean" },
                "acknowledgeMount": { "type": "boolean" }
            }
        },
        "database-native-start": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "$schema": { "type": "string" }, "command": { "const": "database" } }
        },
        "database-native-stop": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "$schema": { "type": "string" }, "command": { "const": "database" }, "acknowledgeInUse": { "type": "boolean" } }
        },
        "database-native-repair": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "$schema": { "type": "string" }, "command": { "const": "database" } }
        },
        "database-native-relocate": {
            "type": "object",
            "description": "`goobster-manager database native relocate`: move the cluster's data directory. Needs the maintenance barrier held and a verified backup first; the original directory is kept.",
            "additionalProperties": false,
            "required": ["target", "backup", "maintenance"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "database" },
                "target": { "$ref": "#/definitions/nativeRequest/properties/dataDirectory" },
                "acknowledgeMount": { "type": "boolean" },
                "maintenance": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["operationId", "fence"],
                    "properties": { "operationId": { "type": "string", "minLength": 1, "maxLength": 64 }, "fence": { "type": "integer" } }
                },
                "backup": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["dir"],
                    "properties": {
                        "dir": { "$ref": "#/definitions/absolutePath" },
                        "passphrase": { "type": "string", "minLength": 1, "maxLength": 1024 },
                        "skipConfig": { "type": "boolean" }
                    }
                }
            }
        },
        "database-docker-reconfigure": {
            "type": "object",
            "description": "`goobster-manager database docker reconfigure`: change the port, bind address or memory limit. Needs the maintenance barrier held and a verified backup first.",
            "additionalProperties": false,
            "required": ["backup", "maintenance"],
            "properties": {
                "$schema": { "type": "string" },
                "command": { "const": "database" },
                "port": { "type": "integer" },
                "bind": { "type": "string", "minLength": 7, "maxLength": 15, "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$" },
                "acknowledgeLanBind": { "type": "boolean" },
                "memoryMb": { "type": "integer" },
                "maintenance": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["operationId", "fence"],
                    "properties": { "operationId": { "type": "string", "minLength": 1, "maxLength": 64 }, "fence": { "type": "integer" } }
                },
                "backup": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["dir"],
                    "properties": {
                        "dir": { "$ref": "#/definitions/absolutePath" },
                        "passphrase": { "type": "string", "minLength": 1, "maxLength": 1024 },
                        "skipConfig": { "type": "boolean" }
                    }
                }
            }
        }
    }
}

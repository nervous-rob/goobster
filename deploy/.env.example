# Copy to deploy/.env (gitignored) before `docker compose -f deploy/docker-compose.yml up`.

# Required. Use a long random string for the bot↔api shared secret.
POSTGRES_PASSWORD=change-me
GOOBSTER_INTERNAL_TOKEN=change-me-to-a-long-random-string

# Optional AI / integration keys (config.json also works; env wins).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# PERPLEXITY_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
